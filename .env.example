# ─────────────────────────────────────────────────────────────
# Lakeside Dental Booking Agent — environment template
# Copy this file to `.env` and fill in the two API keys.
# `.env` is gitignored; never commit real keys.
# ─────────────────────────────────────────────────────────────

# ── LLM providers ────────────────────────────────────────────
# PRIMARY — OpenAI (server-side only, never sent to the browser)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# FALLBACK — Groq (used automatically if OpenAI errors/times-out/rate-limits)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ── Resilience knobs ─────────────────────────────────────────
LLM_TIMEOUT_MS=20000          # per-call deadline before abort
LLM_MAX_RETRIES=2             # transient-error retries before failover
BREAKER_THRESHOLD=3           # failures before a provider circuit opens
BREAKER_COOLDOWN_MS=30000     # how long the circuit stays open
MAX_TOOL_ITERS=5              # safety bound on the agent tool loop

# ── Server ───────────────────────────────────────────────────
PORT=8787
WEB_ORIGIN=http://localhost:5173
RATE_LIMIT_PER_MIN=60         # per-IP requests/minute
LOG_LEVEL=info

# Calendar seeding on boot: default (demo mix) | open (all weekdays free) | empty (no slots)
SEED_MODE=default

# ── Frontend (Vite; only VITE_-prefixed vars reach the browser) ─
VITE_API_BASE=http://localhost:8787
